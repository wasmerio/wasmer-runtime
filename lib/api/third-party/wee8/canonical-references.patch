+own<Trap> RefConversionTrap(StoreImpl* store, const char* message) {
+  CHECK_NOT_NULL(message);
+  size_t length = std::strlen(message) + 1;
+  auto text = Message::make_uninitialized(length);
+  CHECK_NOT_NULL(text.get());
+  std::memcpy(text.get(), message, length);
+  auto trap = Trap::make(seal<Store>(store), text);
+  // Allocation failure must never become the null/success return channel.
+  CHECK(trap);
+  return trap;
+}
+
+template <typename T>
+bool CapiValueKind(T type, ValKind* kind) {
+  switch (type.kind()) {
+    case i::wasm::kI32: *kind = ValKind::I32; return true;
+    case i::wasm::kI64: *kind = ValKind::I64; return true;
+    case i::wasm::kF32: *kind = ValKind::F32; return true;
+    case i::wasm::kF64: *kind = ValKind::F64; return true;
+    case i::wasm::kS128: *kind = ValKind::V128; return true;
+    case i::wasm::kRef:
+    case i::wasm::kRefNull:
+      if (type.has_index()) return false;
+      switch (type.heap_representation()) {
+        case i::wasm::HeapType::kFunc: *kind = ValKind::FUNCREF; return true;
+        case i::wasm::HeapType::kExtern: *kind = ValKind::EXTERNREF; return true;
+        default: return false;
+      }
+    default: return false;
+  }
+}
+
+bool CapiValueKind(ValKind kind) {
+  switch (kind) {
+    case ValKind::I32:
+    case ValKind::I64:
+    case ValKind::F32:
+    case ValKind::F64:
+    case ValKind::V128:
+    case ValKind::FUNCREF:
+    case ValKind::EXTERNREF:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool CapiValuesMatch(const vec<Val>& values, const ownvec<ValType>& types) {
+  if (values.size() != types.size()) return false;
+  for (size_t index = 0; index < types.size(); ++index) {
+    if (!CapiValueKind(types[index]->kind()) ||
+        values[index].kind() != types[index]->kind()) return false;
+  }
+  return true;
+}
+
