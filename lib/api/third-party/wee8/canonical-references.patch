+
+// Tags alone do not prove that a FUNCREF actually holds a function object.
+// Keep this direct-host path external-to-external; conversion only validates.
+const char* CapiReferenceError(StoreImpl* store, const vec<Val>& values,
+                               const ownvec<ValType>& types) {
+  for (size_t index = 0; index < types.size(); ++index) {
+    auto kind = types[index]->kind();
+    if (!is_ref(kind)) continue;
+    const char* error_message;
+    i::DirectHandle<i::Object> internal;
+    if (!i::wasm::JSToWasmObject(store->i_isolate(), nullptr,
+                                 WasmRefToV8(store->i_isolate(), values[index].ref()),
+                                 WasmValKindToV8(kind), &error_message)
+             .ToHandle(&internal)) {
+      return error_message;
+    }
+  }
+  return nullptr;
+}
+
+i::Address ThrowCapiTrap(i::Isolate* isolate, own<Trap> trap) {
+  isolate->Throw(*impl(trap.get())->v8_object());
+  i::Tagged<i::Object> exception = isolate->exception();
+  isolate->clear_exception();
+  return exception.ptr();
+}
